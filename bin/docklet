#!/bin/bash
# Management utility for docklet — the collection of containerised CLI wrappers.
set -e

# The docklet script is installed by cloning the docklets repo into a share dir
# (e.g. ~/.local/share/docklets) and symlinking this script onto PATH (e.g.
# ~/.local/bin/docklet). Resolve the symlink chain by hand (readlink -f is GNU-only)
# to find the real script inside the clone, so REPO_DIR/BIN_DIR point at the share
# dir — not at the PATH dir the symlink lives in.
SOURCE="$0"
while [ -h "$SOURCE" ]; do
	dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	case "$SOURCE" in /*) ;; *) SOURCE="$dir/$SOURCE" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd -P "${BIN_DIR}/.." && pwd)"

# The directory this script was invoked through (the PATH dir the symlink lives in).
# `add` links new docklets here so they land on the same PATH entry as docklet itself,
# keeping system-wide and per-user installs consistent.
INVOKED_BIN_DIR="$(cd -P "$(dirname "$0")" && pwd)"

_list_docklets() {
	find "${BIN_DIR}" -maxdepth 1 -type f ! -name 'docklet' | sort | while IFS= read -r f; do
		basename "${f}"
	done
}

cmd="${1:-help}"
shift || true

case "${cmd}" in
	help|--help|-h)
		cat <<-EOF
		docklet — manage containerised CLI tool wrappers

		Each wrapper in bin/ runs a developer tool inside a throwaway container,
		using Apple's \`container\` CLI.  The host only needs that and Bash.

		Usage:
		  docklet help
		  docklet home
		  docklet update
		  docklet add <name> [<alias>]
		  docklet rm <name|alias>

		Commands:
		  help               Show this help message
		  home               Print the docklet clone root directory
		  update             Pull the latest scripts from upstream (git pull)
		  add <name> [alias] Symlink a docklet into ~/.local/bin
		                     If <alias> is omitted the docklet name is used
		  rm <name|alias>    Remove a docklet's symlink from ~/.local/bin
		                     (its data in ~/docklet-data is kept)

		Available docklets:
		EOF
		_list_docklets | while IFS= read -r name; do
			printf '  %s\n' "${name}"
		done
		;;

	home)
		echo "${REPO_DIR}"
		;;

	update)
		echo "Updating docklets..."
		git -C "${REPO_DIR}" pull
		echo "Done."
		;;

	add)
		name="${1:?Usage: docklet add <name> [<alias>]}"
		dest_name="${2:-${name}}"
		src="${BIN_DIR}/${name}"
		dst="${INVOKED_BIN_DIR}/${dest_name}"

		if [ "${name}" = "docklet" ]; then
			echo "Error: 'docklet' is the manager, not a docklet" >&2
			exit 1
		fi

		if [ ! -f "${src}" ]; then
			echo "Error: no docklet named '${name}' found in ${BIN_DIR}" >&2
			exit 1
		fi

		# If something already exists at the destination, only treat it as success
		# when it's a symlink already pointing at this same source; otherwise refuse
		# to clobber it so an unrelated file or stale link is never silently replaced.
		if [ -e "${dst}" ] || [ -h "${dst}" ]; then
			if [ -h "${dst}" ] && [ "$(readlink "${dst}")" = "${src}" ]; then
				echo "Already linked: ${dst} -> ${src}"
				exit 0
			fi
			echo "Error: ${dst} already exists and is not a link to ${src}" >&2
			exit 1
		fi

		ln -s "${src}" "${dst}"
		echo "Linked: ${dst} -> ${src}"
		;;

	rm)
		name="${1:?Usage: docklet rm <name|alias>}"
		dst="${INVOKED_BIN_DIR}/${name}"

		if [ "${name}" = "docklet" ]; then
			echo "Error: 'docklet' is the manager, not a docklet" >&2
			exit 1
		fi

		# Only remove a symlink that points into this clone's bin/, so rm can never
		# delete an unrelated file or a link someone else put there.
		if [ ! -h "${dst}" ]; then
			echo "Error: ${dst} is not a docklet symlink" >&2
			exit 1
		fi
		target="$(readlink "${dst}")"
		case "${target}" in
			"${BIN_DIR}"/*) ;;
			*)
				echo "Error: ${dst} points to ${target}, not into ${BIN_DIR}; leaving it alone" >&2
				exit 1
				;;
		esac

		rm "${dst}"
		if [ -e "${dst}" ] || [ -h "${dst}" ]; then
			echo "Error: failed to remove ${dst}" >&2
			exit 1
		fi
		echo "Removed: ${dst} (data in ~/docklet-data/${name} kept)"
		;;

	*)
		echo "Unknown command: ${cmd}" >&2
		echo "Run 'docklet help' for usage." >&2
		exit 1
		;;
esac
