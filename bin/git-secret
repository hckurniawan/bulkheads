#!/bin/bash
# Wrapper that runs git-secret by handing off to the gpg wrapper, whose image carries
# git-secret next to GnuPG, so git-secret always runs exactly the gpg the gpg wrapper
# runs. Building, `git-secret update` (which rebuilds the shared image) and the mounts
# all live in bin/gpg.
#
# The keyring is chosen by the repository, not by this wrapper's name: set
#   git config bulkhead.gpgKeyring gpg-work
# to use ~/bulkhead-data/gpg-work (the keyring of a `gpg-work` alias). Without the setting,
# the `gpg` keyring is used.
#
# git-secret runs without `gpg` linked, but its keys are imported and managed through the
# gpg wrapper, so `bulkhead add git-secret` offers to add `gpg` too.
# bulkhead-needs: gpg
set -e

# Locate the bulkhead clone via the installed `bulkhead` manager (must be on PATH).
# Hard requirement — no local fallback.
BULKHEAD_HOME="$(bulkhead home)" || { echo "bulkhead not found on PATH; install bulkhead first" >&2; exit 1; }

# Sets KEYRING from bulkhead.gpgKeyring in the current directory's git config (a global
# value applies too, and the repository's own overrides it), or to empty when it isn't
# set. Git on the Mac is already a bulkhead requirement. `git config --get` exits 1 only
# for an unset key; any other failure, such as an unreadable config, stops here rather
# than silently falling back to another keyring.
resolve_keyring() {
	local status
	KEYRING=""
	status=0
	KEYRING="$(git config --get bulkhead.gpgKeyring)" || status=$?

	case "${status}" in
		0) ;;
		1) KEYRING="" ;;
		*)
			echo "git-secret: could not read bulkhead.gpgKeyring from git config (exit ${status})." >&2
			exit 1
			;;
	esac
}

# Runs bin/gpg by its path in the clone with git-secret as the tool and the resolved
# keyring; bin/gpg validates the keyring name and checks that it exists.
main() {
	resolve_keyring
	BULKHEAD_GPG_TOOL=git-secret BULKHEAD_GPG_KEYRING="${KEYRING}" exec "${BULKHEAD_HOME}/bin/gpg" "$@"
}

main "$@"
