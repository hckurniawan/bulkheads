#!/bin/bash
# Wrapper that runs git-secret by handing off to the gpg wrapper, whose image carries
# git-secret next to GnuPG, so git-secret always runs exactly the gpg the gpg wrapper
# runs. Building, `git-secret update` (which rebuilds the shared image) and the mounts
# all live in bin/gpg.
#
# The keyring is chosen by the repository, not by this wrapper's name: set
#   git config docklet.gpgKeyring gpg-work
# to use ~/docklet-data/gpg-work (the keyring of a `gpg-work` alias). Without the setting,
# the `gpg` keyring is used.
set -e

# Locate the docklet clone via the installed `docklet` manager (must be on PATH).
# Hard requirement — no local fallback.
DOCKLET_HOME="$(docklet home)" || { echo "docklet not found on PATH; install docklet first" >&2; exit 1; }

# Sets KEYRING from docklet.gpgKeyring in the current directory's git config (a global
# value applies too, and the repository's own overrides it), or to empty when it isn't
# set. Git on the Mac is already a docklet requirement. `git config --get` exits 1 only
# for an unset key; any other failure, such as an unreadable config, stops here rather
# than silently falling back to another keyring.
resolve_keyring() {
	local status
	KEYRING=""
	status=0
	KEYRING="$(git config --get docklet.gpgKeyring)" || status=$?

	case "${status}" in
		0) ;;
		1) KEYRING="" ;;
		*)
			echo "git-secret: could not read docklet.gpgKeyring from git config (exit ${status})." >&2
			exit 1
			;;
	esac
}

# Runs bin/gpg by its path in the clone with git-secret as the tool and the resolved
# keyring; bin/gpg validates the keyring name and checks that it exists.
main() {
	resolve_keyring
	DOCKLET_GPG_TOOL=git-secret DOCKLET_GPG_KEYRING="${KEYRING}" exec "${DOCKLET_HOME}/bin/gpg" "$@"
}

main "$@"
