#!/bin/bash
# Wrapper that runs GnuPG inside a throwaway container, building the image on first
# use from a pinned Alpine base and supporting `gpg update` to force a rebuild.
#
# The image also carries git-secret, so git-secret always runs against this exact gpg:
# bin/git-secret sets DOCKLET_GPG_TOOL=git-secret (and DOCKLET_GPG_KEYRING) and execs
# this script.
set -e

# Locate the docklet clone via the installed `docklet` manager (must be on PATH)
# so the shared lib can be sourced. Hard requirement — no local fallback.
DOCKLET_HOME="$(docklet home)" || { echo "docklet not found on PATH; install docklet first" >&2; exit 1; }
. "${DOCKLET_HOME}/lib/common.sh"

# Base image, pinned to a fixed tag rather than :latest. Moving to a newer Alpine
# means bumping this tag by hand.
ALPINE_IMAGE="alpine:3.24.2"

# git-secret release, and the SHA-256 of its GitHub source tarball. Moving to a newer
# release means bumping both by hand.
GIT_SECRET_VERSION="0.5.0"
GIT_SECRET_SHA256="1cba04a59c8109389079b479c1bf5719b595e799680e10d35ce9aa091cb752af"

# DATA_DIR is mounted into the container as /root/.gnupg (gpg's default home) and
# holds the keyrings, trust database and config. data_dir derives it from the invoked
# name, so symlinking this script under a different name gives a separate keyring.
# DOCKLET_GPG_KEYRING names another keyring instead: bin/git-secret sets it from the
# repository's docklet.gpgKeyring git config, and leaves it empty for the `gpg` keyring.
if [ -n "${DOCKLET_GPG_KEYRING:-}" ]; then
	DATA_DIR="$(data_dir "${DOCKLET_GPG_KEYRING}")"
else
	DATA_DIR="$(data_dir)"
fi

# Name of the image to build and run.
IMAGE="docklet/gpg"

# Builds the image from the inline Dockerfile. The Dockerfile is piped to
# image_build, which spools it to a file, builds it against an empty context and
# stamps the build time. Whether a build is needed at all is image_needs_build's call.
#
# git-secret's `make build` only concatenates its shell sources into one script, so make
# is installed as a virtual package and removed in the same layer.
#
# The entrypoint creates /run/user/0, then execs the tool named by its first argument.
# When that directory exists, GnuPG puts all its sockets (gpg-agent, dirmngr, keyboxd)
# under /run/user/0/gnupg instead of the home directory, which is a bind mount. It is
# created at run time rather than baked in, in case /run is a fresh tmpfs at start.
build() {
	log_info "Building image..."
	image_build "${IMAGE}" <<-EOF
		FROM ${ALPINE_IMAGE}

		RUN apk add --no-cache gnupg bash coreutils gawk git \\
		    && apk add --no-cache --virtual .build-deps make \\
		    && cd /tmp \\
		    && wget -O source.tgz "https://github.com/sobolevn/git-secret/archive/refs/tags/v${GIT_SECRET_VERSION}.tar.gz" \\
		    && echo "${GIT_SECRET_SHA256}  source.tgz" | sha256sum -c - \\
		    && tar xzf source.tgz \\
		    && make -C "git-secret-${GIT_SECRET_VERSION}" build \\
		    && install -m 0755 "git-secret-${GIT_SECRET_VERSION}/git-secret" /usr/bin/git-secret \\
		    && apk del .build-deps \\
		    && rm -rf /tmp/* /var/cache/apk/* \\
		    && git config --system --add safe.directory /data

		ENTRYPOINT [ "/bin/sh", "-c", "mkdir -p -m 700 /run/user/0 && exec \\"\$@\\"", "entrypoint" ]
	EOF
}

# Sets TOOL to the command to run in the container, from DOCKLET_GPG_TOOL (default
# gpg). Only the tools this image installs are accepted, so a stray value never runs
# something unexpected.
resolve_tool() {
	TOOL="${DOCKLET_GPG_TOOL:-gpg}"

	case "${TOOL}" in
		gpg | git-secret) ;;
		*)
			log_error "DOCKLET_GPG_TOOL must be gpg or git-secret, got '${TOOL}'."
			exit 1
			;;
	esac
}

# Ensures the image exists, then runs the tool against the current directory. For
# git-secret that must be the repository root: only it is mounted, so a parent's .git
# isn't visible.
main() {
	resolve_tool

	# `update` before the first `--` is ours; everything else goes to the tool.
	args_parse update "$@"

	container_require

	if [ "${ARGS_COMMAND}" = "update" ]; then
		image_update "${IMAGE}" "the latest GnuPG in Alpine ${ALPINE_IMAGE##*:}, with git-secret ${GIT_SECRET_VERSION}" || exit 1
		exit 0
	fi

	# The base and git-secret are both pinned, and GnuPG comes from that Alpine release's
	# repository, so the image only needs building when it is missing. `gpg update`
	# (or `git-secret update`) rebuilds to pick up patched packages.
	image_needs_build "${IMAGE}" missing && build

	# A keyring named through DOCKLET_GPG_KEYRING must already exist: creating it here
	# would hand git-secret an empty keyring that can't decrypt anything.
	if [ -n "${DOCKLET_GPG_KEYRING:-}" ] && [ ! -d "${DATA_DIR}" ]; then
		log_error "The '${DOCKLET_GPG_KEYRING}' keyring doesn't exist. Add it with \`docklet add gpg ${DOCKLET_GPG_KEYRING}\` and import your keys, or fix docklet.gpgKeyring in the repository's git config."
		exit 1
	fi

	# gpg warns about unsafe permissions unless its home directory is private.
	mkdir -p "${DATA_DIR}"
	chmod 700 "${DATA_DIR}"

	# Allocate a TTY only when both stdin and stdout are one, so redirected output
	# doesn't get CRLF newlines.
	tty_flag="-i"
	[ -t 0 ] && [ -t 1 ] && tty_flag="-it"

	# No --user: `container` bind mounts are root-owned inside the guest (no uid mapping
	# yet — apple/container#165); files written by in-container root still come back
	# owned by the invoking macOS user.
	container run ${tty_flag} --init --rm \
		-v "${DATA_DIR}:/root/.gnupg" \
		-v "$( pwd ):/data" \
		-w /data \
		"${IMAGE}" "${TOOL}" "${FORWARD_ARGS[@]}"
}

main "$@"
