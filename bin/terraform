#!/bin/bash
# Wrapper that runs Terraform inside a throwaway container using the official image.
set -e

# Locate the docklet clone via the installed `docklet` manager (must be on PATH)
# so the shared lib can be sourced. Hard requirement — no local fallback.
DOCKLET_HOME="$(docklet home)" || { echo "docklet not found on PATH; install docklet first" >&2; exit 1; }
. "${DOCKLET_HOME}/lib/common.sh"

# Official image the wrapper runs Terraform in. Docker Hub moves the major.minor tag to
# each new patch release, so this tracks 1.15.x; a new minor or major is a hand edit.
IMAGE="hashicorp/terraform:1.15"

# The official image is pulled, not built. image_needs_build has already removed a stale
# local copy, so `container run` pulls the current tag; all that's left is recording
# the digest it adopted, so the next check compares against it.
pull() {
	image_record_base "${IMAGE}" "${IMAGE}"
}

# Runs Terraform in the official container, mounting the current directory.
main() {
	# `update` before the first `--` is ours; everything else goes to the tool.
	args_parse update "$@"

	container_require

	if [ "${ARGS_COMMAND}" = "update" ]; then
		image_update "${IMAGE}" "the latest Terraform ${IMAGE##*:}.x release" || exit 1
		exit 0
	fi

	# Pull again when the image is missing or Docker Hub has moved the tag (checked at
	# most once per STALENESS_PERIOD). `terraform update` forces a fresh pull.
	image_needs_build "${IMAGE}" base "${IMAGE}" && pull

	log_info "Running Terraform in a container, mounting the current directory..."
	log_info "Note: Terraform will see the current directory as /data inside the container."

	# No --user: `container` bind mounts are root-owned inside the guest (no uid mapping
	# yet — apple/container#165), and files written by in-container root come back owned
	# by the invoking macOS user anyway.
	container run \
		-it --rm \
		-e "HOME=/tmp" \
		-v "$( pwd )":/data \
		-w /data \
		"${IMAGE}" \
		"${FORWARD_ARGS[@]}"
}

main "$@"
