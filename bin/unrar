#!/bin/bash
# Wrapper that runs unrar inside a throwaway container, building the image on
# first use from a pinned source tarball.
set -e

# Locate the docklet clone via the installed `docklet` manager (must be on PATH)
# so the shared lib can be sourced. Hard requirement — no local fallback.
DOCKLET_HOME="$(docklet home)" || { echo "docklet not found on PATH; install docklet first" >&2; exit 1; }
. "${DOCKLET_HOME}/lib/common.sh"

# Base image the container is built from.
BASE_IMAGE="alpine:3.17.2"

# Pinned unrar source tarball. Bump this (and the URL) to move to a newer release.
UNRAR_SOURCE_URL="https://gallium.magmanite.net/public/dev-file-repo/raw/21de1cd3e681ff37f4e75773b87cb444c26d1b16/unrar/unrarsrc-6.2.6.tar.gz"

# Name of the image to build and run.
IMAGE="docklet/unrar"

# Builds the image from the inline Dockerfile. The Dockerfile is piped to
# image_build, which spools it to a file and builds it against an empty context.
# Whether a build is needed at all is image_needs_build's call, not this function's.
build() {
	log_info "Building image..."
	image_build "${IMAGE}" <<-EOF
		FROM ${BASE_IMAGE} as build

		RUN apk add --no-cache g++ make \\
		    && wget -O unrar.tgz "${UNRAR_SOURCE_URL}" \\
		    && tar xzf unrar.tgz \\
		    && cd /unrar \\
		    && make

		FROM ${BASE_IMAGE}

		RUN apk add --no-cache libstdc++ \\
		    && rm -rf /var/cache/apk/*

		COPY --from=build /unrar/unrar /usr/bin/unrar

		ENTRYPOINT [ "/usr/bin/unrar" ]
	EOF
}

# Ensures the image is current, then runs unrar against the current directory.
# Allocate a TTY only when stdin is one, so the wrapper stays usable in pipelines.
main() {
	container_require

	# Both the base image and the unrar source tarball are pinned, so nothing can drift:
	# the image only ever needs building when it is missing.
	image_needs_build "${IMAGE}" missing && build

	tty_flag="-i"
	[ -t 0 ] && tty_flag="-it"

	# No --user: `container` bind mounts are root-owned inside the guest (no uid mapping
	# yet — apple/container#165); extracted files still come back owned by the invoking
	# macOS user.
	container run \
		${tty_flag} \
		--rm \
		-v "$( pwd ):/data" \
		-w /data \
		"${IMAGE}" "$@"
}

main "$@"
